    {
      "id": "f_derivation",
      "kind": "math",
      "name": "derivation",
      "source": "f'(x) &= \\lim_{h \\to 0} \\frac{(x+h)^2 - x^2}{h} \\\\\n  &= \\lim_{h \\to 0} \\frac{x^2 + 2xh + h^2 - x^2}{h} \\\\\n  &= \\lim_{h \\to 0} \\frac{2xh + h^2}{h} \\\\\n  &= \\lim_{h \\to 0} (2x + h) \\\\\n  &= 2x",
      "packages": [],
