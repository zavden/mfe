{
  "name": "manim-formula-editor-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --update=none",
    "test:unit": "vitest run --project unit --update=none",
    "test:native": "vitest run --project native --update=none",
    "test:watch": "vitest",
    "test:watch:unit": "vitest --project unit",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "parity": "node ../tests/parity/run.mjs",
    "export-check": "vitest run --config vitest.export.config.ts",
    "dist-check": "npm run build && playwright test --config playwright.dist.config.ts"
  },
  "dependencies": {
    "immer": "11.2.9",
    "mathjax-full": "3.2.2",
    "mathlive": "0.111.1",
    "mediabunny": "1.65.2",
    "mp4-muxer": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.1",
    "webm-muxer": "5.1.4",
    "zod": "4.6.7",
    "zundo": "2.3.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
